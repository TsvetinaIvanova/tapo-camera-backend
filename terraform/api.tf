# ── HTTP API ────────────────────────────────────────────────

resource "aws_apigatewayv2_api" "tapo" {
  name          = "tapo-camera-api"
  protocol_type = "HTTP"

  cors_configuration {
    # The frontend bucket is reachable at two origins: the website endpoint
    # (HTTP only) and the regional REST endpoint (HTTPS, /index.html).
    allow_origins = concat(
      [
        "http://${aws_s3_bucket_website_configuration.frontend.website_endpoint}",
        "https://${aws_s3_bucket.frontend.bucket_regional_domain_name}",
      ],
      var.api_cors_extra_origins,
    )
    allow_methods = ["GET", "OPTIONS"]
    allow_headers = ["Content-Type", "x-api-key"]
    max_age       = 300
  }
}

resource "aws_apigatewayv2_stage" "tapo" {
  api_id      = aws_apigatewayv2_api.tapo.id
  name        = "$default"
  auto_deploy = true
}

resource "aws_apigatewayv2_integration" "clip_query" {
  api_id             = aws_apigatewayv2_api.tapo.id
  integration_type   = "AWS_PROXY"
  integration_uri    = module.query.invoke_arn
  integration_method = "POST"
}

resource "aws_apigatewayv2_route" "get_clips" {
  api_id    = aws_apigatewayv2_api.tapo.id
  route_key = "GET /clips"
  target    = "integrations/${aws_apigatewayv2_integration.clip_query.id}"

  authorization_type = "CUSTOM"
  authorizer_id      = aws_apigatewayv2_authorizer.shared_secret.id
}

resource "aws_lambda_permission" "allow_apigw" {
  statement_id  = "AllowAPIGatewayInvoke"
  action        = "lambda:InvokeFunction"
  function_name = module.query.function_name
  principal     = "apigateway.amazonaws.com"
  source_arn    = "${aws_apigatewayv2_api.tapo.execution_arn}/*/*"
}

# ── Query Lambda ────────────────────────────────────────────

module "query" {
  source = "./modules/lambda"

  function_name = "tapo-clip-query"
  source_file   = "${path.module}/lambda/query/handler.py"
  timeout       = 15
  memory_size   = 256

  environment = {
    DYNAMODB_TABLE       = aws_dynamodb_table.camera_clips.name
    S3_BUCKET            = aws_s3_bucket.camera_clips.id
    PRESIGNED_URL_EXPIRY = "3600" # 1 hour
  }
}

# DynamoDB read — scoped to this table only
resource "aws_iam_role_policy" "lambda_query_dynamodb" {
  name = "tapo-clip-query-dynamodb"
  role = module.query.role_name

  policy = jsonencode({
    Version = "2012-10-17"
    Statement = [{
      Sid    = "ReadClipMetadata"
      Effect = "Allow"
      Action = ["dynamodb:Query"]
      Resource = [
        aws_dynamodb_table.camera_clips.arn,
        "${aws_dynamodb_table.camera_clips.arn}/index/*",
      ]
    }]
  })
}

# S3 presigned URL generation — needs GetObject on clips and thumbnails
resource "aws_iam_role_policy" "lambda_query_s3" {
  name = "tapo-clip-query-s3"
  role = module.query.role_name

  policy = jsonencode({
    Version = "2012-10-17"
    Statement = [{
      Sid    = "GeneratePresignedUrls"
      Effect = "Allow"
      Action = ["s3:GetObject"]
      Resource = [
        "${aws_s3_bucket.camera_clips.arn}/clips/*",
        "${aws_s3_bucket.camera_clips.arn}/thumbnails/*",
      ]
    }]
  })
}

# ── Shared-secret authorizer ────────────────────────────────

# Generated by Terraform (never typed into a .tfvars file), so there's
# no secret to accidentally commit and no interactive prompt needed in
# CI. Retrieve it once after apply with:
#   terraform output -raw api_shared_secret
# and paste it into the frontend's access-code prompt.
resource "random_password" "api_shared_secret" {
  length  = 32
  special = false # keep it easy to type/paste without escaping issues
}

resource "aws_ssm_parameter" "api_shared_secret" {
  name  = "/tapo/api-shared-secret"
  type  = "SecureString"
  value = random_password.api_shared_secret.result
}

resource "aws_apigatewayv2_authorizer" "shared_secret" {
  api_id                            = aws_apigatewayv2_api.tapo.id
  authorizer_type                   = "REQUEST"
  authorizer_uri                    = module.authorizer.invoke_arn
  identity_sources                  = ["$request.header.x-api-key"]
  name                              = "tapo-shared-secret-authorizer"
  authorizer_payload_format_version = "2.0"
  enable_simple_responses           = true

  # The secret essentially never changes, so cache the authorization
  # decision for 5 minutes — cuts authorizer Lambda invocations (and
  # SSM calls) way down without meaningfully weakening security: a
  # revoked/rotated secret takes at most 5 minutes to take effect.
  authorizer_result_ttl_in_seconds = 300
}

module "authorizer" {
  source = "./modules/lambda"

  function_name = "tapo-api-authorizer"
  source_file   = "${path.module}/lambda/authorizer/handler.py"
  timeout       = 5
  memory_size   = 128

  environment = {
    SECRET_PARAMETER_NAME = aws_ssm_parameter.api_shared_secret.name
  }
}

# Scoped to only this one parameter — least privilege, matching the
# convention already used for the query Lambda's DynamoDB/S3 access.
resource "aws_iam_role_policy" "lambda_authorizer_ssm" {
  name = "tapo-api-authorizer-ssm"
  role = module.authorizer.role_name

  policy = jsonencode({
    Version = "2012-10-17"
    Statement = [{
      Sid      = "ReadSharedSecret"
      Effect   = "Allow"
      Action   = ["ssm:GetParameter"]
      Resource = aws_ssm_parameter.api_shared_secret.arn
    }]
  })
}

resource "aws_lambda_permission" "allow_apigw_authorizer" {
  statement_id  = "AllowAPIGatewayInvokeAuthorizer"
  action        = "lambda:InvokeFunction"
  function_name = module.authorizer.function_name
  principal     = "apigateway.amazonaws.com"
  source_arn    = "${aws_apigatewayv2_api.tapo.execution_arn}/*/*"
}
