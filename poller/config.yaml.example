# Copy to config.yaml and fill in your values.
# config.yaml is gitignored — never commit real credentials.

aws:
  profile: tapo-poller
  bucket: your-bucket-name
  region: eu-central-1

poller:
  interval_seconds: 900        # 15 minutes
  lookback_hours: 1            # how far back to check for new clips on each run
  state_file: /var/lib/tapo-poller/state.json   # tracks last-seen clip per camera

cameras:
  - name: c225_front
    ip: 192.168.68.100
    user: camera_admin
    password: yourpassword

  - name: c325_garage
    ip: 192.168.68.101
    user: camera_admin
    password: yourpassword